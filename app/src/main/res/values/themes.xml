<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Masroufi" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0A1033</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The launcher activity's theme: night background, the ticket alone, then the app theme. -->
    <style name="Theme.Masroufi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A1033</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_ticket</item>
        <item name="postSplashScreenTheme">@style/Theme.Masroufi</item>
    </style>
</resources>
